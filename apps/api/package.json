{
  "name": "@gyami-global/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/start-local-db.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/start-local-api.ps1",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:bootstrap-production": "tsx prisma/bootstrap-production-admin.ts",
    "prisma:seed-home-hero": "tsx prisma/seed-home-hero.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs-redis/client": "^2.0.1",
    "@nestjs-redis/throttler-storage": "^2.0.1",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "12.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.0.1"
  }
}
