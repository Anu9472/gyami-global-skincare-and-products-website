# Uses the real API by default. Set this to "mock" only for an isolated UI demo.
VITE_API_MODE=http
VITE_API_URL=/api/v1
VITE_DEV_API_TARGET=http://localhost:4000
# Optional Google Identity Services OAuth web-client ID. Configure the matching
# GOOGLE_OAUTH_CLIENT_ID on the API; do not place a client secret in Vite env.
VITE_GOOGLE_CLIENT_ID=
