{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build --workspace @gyami-global/customer-web",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/Admin", "destination": "/admin", "permanent": true },
    {
      "source": "/Admin/:path*",
      "destination": "/admin/:path*",
      "permanent": true
    },
    { "source": "/Vendor", "destination": "/vendor", "permanent": true },
    {
      "source": "/Vendor/:path*",
      "destination": "/vendor/:path*",
      "permanent": true
    },
    { "source": "/Vender", "destination": "/vendor", "permanent": true },
    {
      "source": "/Vender/:path*",
      "destination": "/vendor/:path*",
      "permanent": true
    },
    { "source": "/vender", "destination": "/vendor", "permanent": true },
    {
      "source": "/vender/:path*",
      "destination": "/vendor/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com https://checkout.razorpay.com https://verify.msg91.com https://verify.phone91.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; frame-src https://accounts.google.com https://checkout.razorpay.com https://api.razorpay.com https://verify.msg91.com https://verify.phone91.com; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/v1/categories",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/v1/home-hero-slides",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/v1/category-images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/api/v1/home-hero-images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/api/v1/product-images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/api/v1/products",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/v1/products/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://gyami-global-admin-panel.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://gyami-global-admin-panel.vercel.app/admin/:path*"
    },
    {
      "source": "/vendor",
      "destination": "https://gyami-global-vendor-panel.vercel.app/vendor"
    },
    {
      "source": "/vendor/:path*",
      "destination": "https://gyami-global-vendor-panel.vercel.app/vendor/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gyami-global-api.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
